rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function hasStoredRole(role) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('systemRole', '') == role
          || (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('systemRoles', []).hasAny([role])
          )
        );
    }

    // A verified address, not merely a session: Firebase issues a usable ID token
    // the moment an account is created, and `members` holds records for people who
    // have never signed up — so an unconfirmed signup on someone else's address
    // would otherwise read their record. Mirrors canSyncProfile() in AuthProvider.
    // get() rather than a bare property so a token without the claim is false,
    // not an evaluation error.
    function isSignedIn() {
      return request.auth != null && request.auth.token.get('email_verified', false) == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('admin', false) == true
        || request.auth.token.get('role', '') in ['admin', 'superadmin']
        || hasStoredRole('admin')
        || hasStoredRole('superadmin')
      );
    }

    function isSuperadmin() {
      return isSignedIn() && (
        request.auth.token.get('role', '') == 'superadmin'
        || hasStoredRole('superadmin')
      );
    }

    function isUserAdmin() {
      return isSuperadmin() || hasStoredRole('useradmin');
    }

    function isCustodianOrHigher() {
      return isAdmin() || hasStoredRole('custodian');
    }

    function isEventAdmin() {
      return isAdmin() || hasStoredRole('eventadmin');
    }

    function isOwnMemberRecord() {
      return isSignedIn()
        && request.auth.token.email is string
        && (
          resource.data.email == request.auth.token.email
          || resource.data.email2 == request.auth.token.email
        );
    }

    function hasValidUserSystemRole() {
      return !request.resource.data.keys().hasAny(['systemRole'])
        || request.resource.data.systemRole in ['user', 'useradmin', 'eventadmin', 'admin', 'superadmin', 'custodian'];
    }

    function hasValidUserSystemRoles() {
      return !request.resource.data.keys().hasAny(['systemRoles'])
        || (
          request.resource.data.systemRoles is list
          && request.resource.data.systemRoles.size() <= 6
          && request.resource.data.systemRoles.hasOnly(['user', 'useradmin', 'eventadmin', 'admin', 'superadmin', 'custodian'])
        );
    }

    function hasValidUserApprovalStatus() {
      return !request.resource.data.keys().hasAny(['approvalStatus'])
        || request.resource.data.approvalStatus in ['needs-profile', 'pending', 'approved', 'needs-info'];
    }

    // Every guard below uses affectedKeys(), never changedKeys(): changedKeys()
    // reports only keys present in BOTH the old and the new document, so a field
    // that is merely added — the default state of a fresh signup — slips through.
    function userSelfMayWriteApprovalStatus() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approvalStatus'])
        || request.resource.data.approvalStatus in ['needs-profile', 'pending'];
    }

    function useradminMayWriteApprovalFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'approvalStatus',
          'approvalApprovedAt',
          'approvalApprovedBy',
          'updatedAt'
        ])
        && request.resource.data.approvalStatus in ['approved', 'needs-info'];
    }

    function useradminMayWriteAdminNote() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminNote', 'updatedAt']);
    }

    function hasValidConsentCreatePayload() {
      return request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['status', 'uploadedAt', 'documentName', 'documentPath', 'eventId'])
        && request.resource.data.documentName is string
        && request.resource.data.documentPath is string
        && request.resource.data.uploadedAt == request.time;
    }

    function hasValidRegistrationStatus() {
      return request.resource.data.status in ['pending', 'approved', 'under-review', 'payment-overdue', 'rejected', 'archived'];
    }

    function hasValidOptionalString(field, maxSize) {
      return !request.resource.data.keys().hasAny([field])
        || (request.resource.data[field] is string
          && request.resource.data[field].size() > 0
          && request.resource.data[field].size() <= maxSize);
    }

    // Church managers act for the churches an admin linked to their account
    // (churchManagers/{uid}) — the first step toward logging in as a church.
    function managesChurch(churchId) {
      return isSignedIn()
        && churchId is string
        && exists(/databases/$(database)/documents/churchManagers/$(request.auth.uid))
        && get(/databases/$(database)/documents/churchManagers/$(request.auth.uid)).data.get('churchIds', []).hasAny([churchId]);
    }

    function hasValidChurchManagerPayload() {
      return request.resource.data.keys().hasOnly(['churchIds', 'churchNames', 'email', 'displayName', 'updatedAt', 'updatedBy'])
        && request.resource.data.churchIds is list
        && request.resource.data.churchIds.size() > 0
        && request.resource.data.churchIds.size() <= 30
        && request.resource.data.churchNames is list
        && request.resource.data.churchNames.size() <= 30
        && hasValidOptionalString('email', 320)
        && hasValidOptionalString('displayName', 200)
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    function isAmount(value) {
      return (value is int || value is float) && value >= 0 && value <= 10000000;
    }

    function hasValidWorkRecord() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'churchId', 'churchName', 'date', 'workTypeId', 'workTypeLabel', 'workTypeOther',
          'venueText', 'hymnalText', 'attendees', 'sacrament', 'contributions',
          'reviewStatus', 'reviewedAt', 'reviewedBy', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
        ])
        && data.churchId is string && data.churchId.size() > 0 && data.churchId.size() <= 128
        && data.churchName is string && data.churchName.size() <= 200
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.workTypeId is string && data.workTypeId.size() > 0 && data.workTypeId.size() <= 64
        && data.workTypeLabel is string && data.workTypeLabel.size() > 0 && data.workTypeLabel.size() <= 200
        && hasValidOptionalString('workTypeOther', 200)
        && hasValidOptionalString('venueText', 200)
        && hasValidOptionalString('hymnalText', 500)
        && data.attendees is map
        && data.attendees.keys().hasOnly(['total', 'initiated'])
        && data.attendees.total is int && data.attendees.total >= 0 && data.attendees.total <= 100000
        && data.attendees.initiated is int && data.attendees.initiated >= 0
        && data.attendees.initiated <= data.attendees.total
        && data.contributions is map
        && data.contributions.keys().hasOnly(['collected', 'icefluBrazilQuota'])
        && isAmount(data.contributions.collected)
        && isAmount(data.contributions.icefluBrazilQuota)
        && data.createdBy is string
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time
        && hasValidRecordReview()
        && hasValidWorkSacrament();
    }

    // Work and donation records: pre-approved records carry no reviewer; a review is
    // stamped by the admin who gives it.
    function hasValidRecordReview() {
      let data = request.resource.data;
      let wasReviewed = resource != null && resource.data.get('reviewStatus', '') == 'reviewed';
      return (data.reviewStatus == 'pre-approved' && !data.keys().hasAny(['reviewedAt', 'reviewedBy']))
        || (data.reviewStatus == 'reviewed'
          && data.reviewedBy is string
          && data.reviewedAt is timestamp
          && (wasReviewed || (data.reviewedBy == request.auth.uid && data.reviewedAt == request.time)));
    }

    // The Daime must come from a stock linked to the work's church (a stock can serve
    // several churches). Checked only when
    // the Daime changes, so unlinking a stock later does not lock its old records.
    function hasValidWorkSacrament() {
      let data = request.resource.data;
      return !data.keys().hasAny(['sacrament'])
        || (resource != null && resource.data.get('sacrament', null) == data.sacrament)
        || (data.sacrament is map
          && data.sacrament.keys().hasOnly(['stockId', 'itemId', 'itemLabel', 'quantity', 'unit'])
          && data.sacrament.stockId is string
          && data.sacrament.itemId is string
          && data.sacrament.get('itemLabel', '') is string
          && data.sacrament.get('itemLabel', '').size() <= 300
          && (data.sacrament.quantity is int || data.sacrament.quantity is float)
          && data.sacrament.quantity > 0
          && data.sacrament.quantity <= 1000
          && data.sacrament.unit in ['L', 'kg']
          && get(/databases/$(database)/documents/sacramentItems/$(data.sacrament.itemId)).data.stockId == data.sacrament.stockId
          && (get(/databases/$(database)/documents/sacramentItems/$(data.sacrament.itemId)).data.get('form', 'liquid') == 'gel')
            == (data.sacrament.unit == 'kg')
          && get(/databases/$(database)/documents/sacramentStocks/$(data.sacrament.stockId)).data.get('churchIds', []).hasAny([data.churchId]));
    }

    // A donation sent to ICEFLU Brazil. The receipt (bank statement for a transfer,
    // the recipient's receipt for cash handed over) must sit in this donation's own
    // folder under its church: churches/{churchId}/donations/{donationId}/receipt-*.
    function hasValidDonation(donationId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'churchId', 'churchName', 'date', 'amount', 'reason', 'recipient', 'method',
          'receiptPath', 'receiptName',
          'reviewStatus', 'reviewedAt', 'reviewedBy', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
        ])
        && data.churchId is string && data.churchId.size() > 0 && data.churchId.size() <= 128
        && data.churchName is string && data.churchName.size() <= 200
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (data.amount is int || data.amount is float) && data.amount > 0 && data.amount <= 10000000
        && data.reason in ['feitio', 'membership', 'jurua']
        && data.recipient is string && data.recipient.size() > 0 && data.recipient.size() <= 200
        && data.method in ['bank-transfer', 'in-person']
        && data.receiptPath is string
        && data.receiptPath.split('/').size() == 5
        && data.receiptPath.split('/')[0] == 'churches'
        && data.receiptPath.split('/')[1] == data.churchId
        && data.receiptPath.split('/')[2] == 'donations'
        && data.receiptPath.split('/')[3] == donationId
        && data.receiptPath.split('/')[4].matches('^receipt-.+')
        && data.receiptName is string && data.receiptName.size() > 0 && data.receiptName.size() <= 300
        && data.createdBy is string
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time
        && hasValidRecordReview();
    }

    function recordAuthorshipUnchanged() {
      return request.resource.data.churchId == resource.data.churchId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function hasValidContribution() {
      return request.resource.data.contribution is map
        && request.resource.data.contribution.keys().hasAll([
          'nights',
          'lodging',
          'spiritualWorks',
          'extras',
          'total'
        ])
        && request.resource.data.contribution.keys().hasOnly([
          'nights',
          'lodging',
          'spiritualWorks',
          'extras',
          'total'
        ])
        && request.resource.data.contribution.nights is number
        && request.resource.data.contribution.nights >= 0
        && request.resource.data.contribution.lodging is number
        && request.resource.data.contribution.lodging >= 0
        && request.resource.data.contribution.spiritualWorks is number
        && request.resource.data.contribution.spiritualWorks >= 0
        && request.resource.data.contribution.extras is number
        && request.resource.data.contribution.extras >= 0
        && request.resource.data.contribution.total is number
        && request.resource.data.contribution.total >= 0;
    }

    // events/{eventId}/registrations validation: type/size checks mirrored on create + owner-update.
    function eventRegistrationRequiredFields() {
      return [
        'locale',
        'firstName',
        'lastName',
        'userId',
        'eventId',
        'country',
        'church',
        'centerLeader',
        'isInitiated',
        'isIcefluMember',
        'isNovice',
        'attendanceMode',
        'selectedWorks',
        'needsExtraLinen',
        'contribution',
        'status',
        'submittedAt'
      ];
    }

    function eventRegistrationCreateFields() {
      return [
        'locale',
        'firstName',
        'lastName',
        'userId',
        'eventId',
        'country',
        'church',
        'centerLeader',
        'centerLeaderEmail',
        'isInitiated',
        'isIcefluMember',
        'isNovice',
        'attendanceMode',
        'checkIn',
        'checkOut',
        'selectedWorks',
        'needsExtraLinen',
        'capacityBucket',
        'identityDocumentName',
        'identityDocumentPath',
        'paymentProofName',
        'paymentProofPath',
        'consentDocumentName',
        'consentDocumentPath',
        'phone',
        'phoneCountryCode',
        'email',
        'contribution',
        'status',
        'submittedAt'
      ];
    }

    function eventRegistrationOwnerEditableFields() {
      return [
        'locale',
        'firstName',
        'lastName',
        'country',
        'church',
        'centerLeader',
        'centerLeaderEmail',
        'isInitiated',
        'isIcefluMember',
        'isNovice',
        'attendanceMode',
        'checkIn',
        'checkOut',
        'selectedWorks',
        'needsExtraLinen',
        'identityDocumentName',
        'identityDocumentPath',
        'paymentProofName',
        'paymentProofPath',
        'consentDocumentName',
        'consentDocumentPath',
        'phone',
        'phoneCountryCode',
        'email',
        'contribution'
      ];
    }

    function hasValidEventRegistrationPayload(eventId) {
      return request.resource.data.keys().hasAll(eventRegistrationRequiredFields())
        && request.resource.data.locale in ['pt', 'en', 'es', 'it']
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 120
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0
        && request.resource.data.lastName.size() <= 120
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.eventId == eventId
        && request.resource.data.country is string
        && request.resource.data.country.size() > 0
        && request.resource.data.country.size() <= 120
        && request.resource.data.church is string
        && request.resource.data.church.size() > 0
        && request.resource.data.church.size() <= 240
        && request.resource.data.centerLeader is string
        && request.resource.data.centerLeader.size() > 0
        && request.resource.data.centerLeader.size() <= 240
        && hasValidOptionalString('centerLeaderEmail', 240)
        && request.resource.data.isInitiated is bool
        && request.resource.data.isIcefluMember is bool
        && request.resource.data.isNovice is bool
        && request.resource.data.attendanceMode in ['lodging', 'meals', 'spiritual']
        && hasValidOptionalString('checkIn', 10)
        && hasValidOptionalString('checkOut', 10)
        && request.resource.data.selectedWorks is list
        && request.resource.data.selectedWorks.size() <= 20
        && request.resource.data.needsExtraLinen is bool
        && hasValidOptionalString('capacityBucket', 120)
        && hasValidOptionalString('identityDocumentName', 240)
        && hasValidOptionalString('identityDocumentPath', 1024)
        && hasValidOptionalString('paymentProofName', 240)
        && hasValidOptionalString('paymentProofPath', 1024)
        && hasValidOptionalString('consentDocumentName', 240)
        && hasValidOptionalString('consentDocumentPath', 1024)
        && hasValidOptionalString('phone', 40)
        && hasValidOptionalString('phoneCountryCode', 10)
        && hasValidOptionalString('email', 240)
        && hasValidContribution()
        && hasValidRegistrationStatus();
    }

    function hasValidEventRegistrationCreatePayload(eventId) {
      return request.resource.data.keys().hasOnly(eventRegistrationCreateFields())
        && hasValidEventRegistrationPayload(eventId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.submittedAt == request.time;
    }

    function hasValidEventRegistrationOwnerUpdate() {
      return resource.data.userId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.eventId == resource.data.eventId
        && request.resource.data.status == resource.data.status
        && request.resource.data.submittedAt == resource.data.submittedAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(eventRegistrationOwnerEditableFields())
        && hasValidEventRegistrationPayload(resource.data.eventId);
    }

    // Member profiles: tax code, birth data, address, contacts, identity-document
    // paths, and initiation/doctrine fields. Never public — a member sees their own,
    // user admins see the rest for the approval queue. Rules-internal get() in
    // hasStoredRole() bypasses these, so role checks are unaffected.
    match /users/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isUserAdmin() || isAdmin());
      allow list: if isUserAdmin() || isAdmin();
      allow create: if hasValidUserSystemRole() && hasValidUserSystemRoles() && hasValidUserApprovalStatus() && (
        (isSignedIn()
          && request.auth.uid == uid
          && !request.resource.data.keys().hasAny(['systemRole', 'systemRoles', 'approvalApprovedAt', 'approvalApprovedBy'])
          && (!request.resource.data.keys().hasAny(['approvalStatus']) || request.resource.data.approvalStatus in ['needs-profile', 'pending']))
        || isSuperadmin()
      );
      allow update: if hasValidUserSystemRole() && hasValidUserSystemRoles() && hasValidUserApprovalStatus() && (
        (isSignedIn()
          && request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['systemRole', 'systemRoles', 'approvalApprovedAt', 'approvalApprovedBy'])
          && userSelfMayWriteApprovalStatus())
        || isSuperadmin()
        || (isUserAdmin() && (useradminMayWriteApprovalFields() || useradminMayWriteAdminNote()))
      );
      allow delete: if false;

      match /approvedSnapshots/{snapshotId} {
        allow read: if isSignedIn() && (request.auth.uid == uid || isUserAdmin());
        allow create: if isUserAdmin();
        allow update, delete: if false;
      }

      // Item A: per-user signed informed consent ledger (aging anchor = latest approved).
      match /consents/{consentId} {
        allow read: if isSignedIn() && (request.auth.uid == uid || isUserAdmin() || isEventAdmin());
        allow create: if isSignedIn() && request.auth.uid == uid && hasValidConsentCreatePayload();
        allow update: if isUserAdmin() || isEventAdmin();
        allow delete: if false;
      }
    }

    // App settings managed by user admins (e.g. settings/notifications:
    // recipientUserIds + extraEmails for the registration-pending notice).
    // Cloud Functions read via the admin SDK and bypass these rules.
    match /settings/{doc} {
      allow read: if isUserAdmin();
      allow write: if isUserAdmin();
    }

    // Intended home for daimista profiles: never public, and only admins may write.
    match /pessoas/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // A member whose church is missing may add it (AddChurchModal on the profile
    // form), but only admins may rewrite or remove an existing entry — the risk
    // here is vandalism of the registry, not growth of it.
    match /churches/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /hinarios/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /hinos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Provenance for a controlled substance: integrity matters, so custodians only.
    match /beverageBatches/{id} {
      allow read: if true;
      allow write: if isCustodianOrHigher();
    }

    // Records of works already held, filed by the church's managers. They carry
    // contribution totals and Daime usage, so they are not public: a manager sees
    // their own churches' records, admins see all. Records start pre-approved; only
    // an admin marks one reviewed, and a manager's edit sends it back for review.
    // The Daime movement they imply is booked by onWorkSacramentChange.
    match /trabalhos/{id} {
      allow read: if isAdmin() || managesChurch(resource.data.churchId);
      allow create: if hasValidWorkRecord()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && (isAdmin()
          || (managesChurch(request.resource.data.churchId) && request.resource.data.reviewStatus == 'pre-approved'));
      allow update: if hasValidWorkRecord()
        && recordAuthorshipUnchanged()
        && (isAdmin()
          || (managesChurch(resource.data.churchId) && request.resource.data.reviewStatus == 'pre-approved'));
      allow delete: if isAdmin()
        || (managesChurch(resource.data.churchId) && resource.data.get('reviewStatus', '') == 'pre-approved');
    }

    // Donations a church sent to ICEFLU Brazil, with proof of payment. Same access as
    // work records: the church's managers and admins, pre-approved until an admin
    // reviews them. Receipts live in Storage (see storage.rules).
    match /icefluDonations/{id} {
      allow read: if isAdmin() || managesChurch(resource.data.churchId);
      allow create: if hasValidDonation(id)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && (isAdmin()
          || (managesChurch(request.resource.data.churchId) && request.resource.data.reviewStatus == 'pre-approved'));
      allow update: if hasValidDonation(id)
        && recordAuthorshipUnchanged()
        && (isAdmin()
          || (managesChurch(resource.data.churchId) && request.resource.data.reviewStatus == 'pre-approved'));
      allow delete: if isAdmin()
        || (managesChurch(resource.data.churchId) && resource.data.get('reviewStatus', '') == 'pre-approved');
    }

    // Links accounts to the churches they manage. Granting it lets an account file
    // works for that church and book Daime from its stocks, so only admins write it.
    match /churchManagers/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow create, update: if isAdmin() && hasValidChurchManagerPayload();
      allow delete: if isAdmin();
    }

    // Admin-maintained option lists (catalogs/workTypes: the work-record dropdown).
    match /catalogs/{catalogId} {
      allow read: if isSignedIn();
      allow write: if isAdmin()
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 200;
    }

    match /conceitos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Association members ("soci") unified from the registry/import spreadsheets.
    // Holds personal data (tax codes, addresses), so general browsing stays admin-only.
    // A signed-in user may read only the member document tied to their auth email for profile prefill.
    match /members/{id} {
      allow get, list: if isAdmin() || isOwnMemberRecord();
      allow create, update, delete: if isAdmin();
    }

    // Item C (Phase 4a): generic events authored by eventadmins. Published events are public-readable.
    match /events/{eventId} {
      allow read: if isEventAdmin() || (resource != null && resource.data.status == 'published');
      allow create, update, delete: if isEventAdmin();

      // Phase 4c: a signed-in user owns their own registration while it is pending; eventadmins manage all.
      match /registrations/{registrationId} {
        allow read: if isEventAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
        allow create: if isSignedIn()
          && hasValidEventRegistrationCreatePayload(eventId);
        allow update: if (isEventAdmin() && hasValidRegistrationStatus())
          || (isSignedIn() && hasValidEventRegistrationOwnerUpdate());
        allow delete: if isEventAdmin()
          || (isSignedIn() && resource.data.userId == request.auth.uid && resource.data.status == 'pending');
      }

      // Aggregate capacity counters. Public-readable so the form can show
      // availability, but written only by the onRegistrationCapacityChange Cloud
      // Function, which recounts them from the registrations themselves. No rule
      // can verify a count, so while clients could write these, any signed-in
      // member could set reserved to capacity and close the event for everyone,
      // or set it to zero and overbook it.
      match /capacity/{bucket} {
        allow read: if true;
        allow write: if isEventAdmin();
      }
    }

    // churchIds links a stock to the churches it serves, which lets their managers book
    // Daime from it when recording works — a grant, so only admins may change it.
    match /sacramentStocks/{id} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (isCustodianOrHigher()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['churchIds', 'churchNames']));
      allow delete: if isAdmin();
    }

    match /sacramentItems/{id} {
      allow read: if isSignedIn();
      allow create, update: if isCustodianOrHigher();
      allow delete: if isAdmin();
    }

    match /sacramentTransactions/{id} {
      allow read: if isSignedIn();
      allow create: if isCustodianOrHigher();
      allow update: if isAdmin()
        || (isCustodianOrHigher() && resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Default deny anything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
