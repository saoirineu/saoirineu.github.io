rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // A verified address, not merely a session: Firebase issues a usable ID token
    // the moment an account is created, and `members` holds records for people who
    // have never signed up — so an unconfirmed signup on someone else's address
    // would otherwise read their record. Mirrors canSyncProfile() in AuthProvider.
    // get() rather than a bare property so a token without the claim is false,
    // not an evaluation error.
    function isSignedIn() {
      return request.auth != null && request.auth.token.get('email_verified', false) == true;
    }

    function hasStoredRole(role) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && (
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('systemRole', '') == role
          || (
            firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('systemRoles', []).hasAny([role])
          )
        );
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('admin', false) == true
        || request.auth.token.get('role', '') in ['admin', 'superadmin']
        || hasStoredRole('admin')
        || hasStoredRole('superadmin')
      );
    }

    function isUserAdmin() {
      return isAdmin() || hasStoredRole('useradmin');
    }

    function isEventAdmin() {
      return isAdmin() || hasStoredRole('eventadmin');
    }

    // Mirrors managesChurch() in firestore.rules.
    function managesChurch(churchId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/churchManagers/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/churchManagers/$(request.auth.uid)).data.get('churchIds', []).hasAny([churchId]);
    }

    // A receipt may go when no donation keeps it as proof: the donation is gone,
    // points at another file (the receipt was replaced), or is not reviewed yet.
    function receiptIsDisposable(churchId, donationId, fileName) {
      return !firestore.exists(/databases/(default)/documents/icefluDonations/$(donationId))
        || firestore.get(/databases/(default)/documents/icefluDonations/$(donationId)).data.get('receiptPath', '')
          != 'churches/' + churchId + '/donations/' + donationId + '/' + fileName
        || firestore.get(/databases/(default)/documents/icefluDonations/$(donationId)).data.get('reviewStatus', '') == 'pre-approved';
    }

    function isAllowedDocument() {
      return request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/jpeg|image/png');
    }

    // Ownership regardless of status, so a member keeps access to the documents on
    // their own registration after it is approved.
    function ownsEventRegistration(eventId, registrationId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/events/$(eventId)/registrations/$(registrationId))
        && firestore.get(/databases/(default)/documents/events/$(eventId)/registrations/$(registrationId)).data.userId == request.auth.uid;
    }

    function ownsPendingEventRegistration(eventId, registrationId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/events/$(eventId)/registrations/$(registrationId))
        && firestore.get(/databases/(default)/documents/events/$(eventId)/registrations/$(registrationId)).data.userId == request.auth.uid
        && firestore.get(/databases/(default)/documents/events/$(eventId)/registrations/$(registrationId)).data.status == 'pending';
    }

    // Identity documents, payment proofs and signed consent forms. `read` covers
    // list as well as get, so anything short of ownership would let any account
    // enumerate the whole prefix and download every registrant's documents.
    match /events/{eventId}/registrations/{registrationId}/{fileName} {
      allow read: if isAdmin() || isEventAdmin() || ownsEventRegistration(eventId, registrationId);
      allow create: if ownsPendingEventRegistration(eventId, registrationId)
        && isAllowedDocument()
        && fileName.matches('(identityDocument|paymentProof|consentDocument)-.*');
      allow delete: if isAdmin() || ownsPendingEventRegistration(eventId, registrationId);
      allow update: if false;
    }

    match /users/{uid}/{fileName} {
      allow read: if isUserAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && isAllowedDocument()
        // consentDocument-*: the signed informed consent members send from the
        // home page, feeding the same users/{uid}/consents ledger the event
        // registration writes to.
        && fileName.matches('(identityDocument|consentDocument)-.*');
      allow delete: if isUserAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow update: if false;
    }

    // Receipts for donations a church sent to ICEFLU Brazil (icefluDonations). The
    // church's managers and admins read and upload them. Uploading comes before the
    // donation document exists, so create does not look it up; deleting does, so a
    // manager cannot remove the receipt a reviewed donation still points at.
    match /churches/{churchId}/donations/{donationId}/{fileName} {
      allow read: if isAdmin() || managesChurch(churchId);
      // resource == null: uploading over an existing object counts as create, and would
      // let a manager swap out the proof a reviewed donation points at.
      allow create: if resource == null
        && (isAdmin() || managesChurch(churchId))
        && isAllowedDocument()
        && fileName.matches('receipt-.*');
      allow delete: if isAdmin()
        || (managesChurch(churchId) && receiptIsDisposable(churchId, donationId, fileName));
      allow update: if false;
    }

    // Association documents shown on the membership form: the privacy notice in
    // four languages and the statute. Public, because an applicant must be able
    // to read them before signing up. Uploaded with scripts/upload-documents.mjs
    // by someone holding admin credentials; never writable from a client.
    match /docs/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
